# Copy to .env and fill your OWN long unique secrets. Never commit .env.
ANPR_DOMAIN=anpr.example.com
POSTGRES_USER=smartfuel
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=smartfuel_anpr
POSTGRES_HOST=database
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_64_CHARACTERS_OR_MORE
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
COOKIE_SECURE=1
DEMO_MODE=1
SEED_DEMO=1
DATA_DIR=/service/storage

# Demo rule: set 1 to require an attached sample certificate for sample-valid status.
REQUIRE_SAMPLE_ATTACHMENT=0

# VAHAN Vehicle RC Gateway & Auto-Caching (Open RTO Resolver / RapidAPI / Setu / Surepass)
VAHAN_GATEWAY_ENABLED=1
VAHAN_API_PROVIDER=open    # 'open' (default offline RTO resolver), or 'rapidapi', 'surepass', 'setu'
VAHAN_API_KEY=             # Optional: Add RapidAPI or gateway key for live external API calls
VAHAN_TIMEOUT_SECONDS=2.0
