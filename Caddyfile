{$ANPR_DOMAIN} {
    encode zstd gzip
    @health path /api/health
    handle {
      reverse_proxy web:8000
    }
    header {
      Strict-Transport-Security "max-age=31536000; includeSubDomains"
      X-Content-Type-Options "nosniff"
    }
    log {
      output stdout
      format console
    }
}
